# ==============================================================================
# ERP de Gestión Integral — Inmobiliaria y Constructora SV
# Archivo de Configuración de Variables de Entorno (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL SERVIDOR BACKEND (EXPRESS)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL Y PRISMA ORM
# ------------------------------------------------------------------------------
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_constructora_sv_2026_secret
POSTGRES_DB=erp_constructora_sv_db
POSTGRES_PORT=5432

# En entorno local fuera de Docker usar host "localhost"; dentro de Docker usar "postgres"
DATABASE_URL="postgresql://erp_admin:erp_constructora_sv_2026_secret@postgres:5432/erp_constructora_sv_db?schema=public"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
JWT_SECRET=sv_constructora_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. PARÁMETROS FISCALES Y LABORALES DE EL SALVADOR (VALORES POR DEFECTO)
# ------------------------------------------------------------------------------
SV_IVA_RATE=0.13
SV_ISSS_EMPLOYEE_RATE=0.03
SV_ISSS_MAX_CEILING_MONTHLY=1000.00
SV_AFP_EMPLOYEE_RATE=0.0725

# ------------------------------------------------------------------------------
# 5. FRONTEND (VITE + REACT) y PROXY NGINX
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
NGINX_PUBLIC_PORT=8080

