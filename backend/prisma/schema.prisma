// ============================================================================
// ERP DE GESTIÓN INTEGRAL — INMOBILIARIA Y CONSTRUCTORA SV
// Esquema Principal de Base de Datos (Prisma ORM + PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS DEL SISTEMA
// ============================================================================

// Seguridad y Control de Acceso Basado en Roles (RBAC)
enum RolUsuario {
  ADMIN
  DIRECTOR_PROYECTO
  INGENIERO_RESIDENTE
  BODEGUERO
  RRHH
  VENTAS
}

// Módulo 1: Planificación y Permisología (El Salvador)
enum FaseProyecto {
  DISENO
  TERRACERIA
  OBRA_GRIS
  ACABADOS
  FINALIZADO
}

enum InstitucionPermiso {
  OPAMSS
  MARN
  ANDA
}

enum EstadoPermiso {
  PENDIENTE
  EN_TRAMITE
  OBSERVADO
  APROBADO
  RECHAZADO
}

// Módulo 2: Bodega e Inventario Multi-sitio
enum TipoBodega {
  CENTRAL
  PROYECTO
}

enum EstadoTraslado {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

// Módulo 4: Recursos Humanos y Nómina Dual (Ley Salvadoreña)
enum TipoPlanilla {
  ADMINISTRATIVA_QUINCENAL
  CAMPO_SEMANAL
}

enum ModalidadPagoCampo {
  SALARIO_MENSUAL
  DIA_TRABAJADO
  DESTAJO
}

enum EstadoPlanilla {
  BORRADOR
  APROBADA
  PAGADA
}

// Módulo 5: Ventas e Inmobiliaria CRM y Facturación Fiscal SV
enum TipoCliente {
  NATURAL
  JURIDICO
}

enum TipoUnidadInmobiliaria {
  CASA
  APARTAMENTO
  LOTE
}

enum EstadoUnidad {
  DISPONIBLE
  RESERVADA
  VENDIDA
  ESCRITURADA
}

enum EstadoContrato {
  ACTIVO
  CANCELADO
  FINALIZADO
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  MORA
}

enum TipoDocumentoFiscal {
  RECIBO_ABONO
  FACTURA_CONSUMIDOR_FINAL
  CREDITO_FISCAL_CCF
}

// ============================================================================
// MODELOS: SEGURIDAD Y RBAC
// ============================================================================

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relaciones de trazabilidad y auditoría
  trasladosAutorizados TrasladoBodega[]       @relation("UsuarioAutorizaTraslado")
  reportesAvance       ReporteAvancePartida[] @relation("IngenieroReportaAvance")
  contratosCerrados    ContratoVenta[]        @relation("VendedorContrato")

  @@index([rol])
  @@index([activo])
}

// ============================================================================
// MÓDULO 1: PLANIFICACIÓN Y PERMISOLOGÍA
// ============================================================================

model Proyecto {
  id               String       @id @default(uuid()) @db.Uuid
  codigo           String       @unique // Ej. "PROY-SV-001"
  nombre           String
  ubicacion        String
  presupuestoTotal Decimal      @db.Decimal(14, 2)
  costoEjecutado   Decimal      @default(0) @db.Decimal(14, 2)
  faseActual       FaseProyecto @default(DISENO)
  fechaInicio      DateTime
  fechaFinEstimada DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relaciones con otros módulos
  permisos              PermisoProyecto[]
  bodega                Bodega?
  partidas              PartidaObra[]
  empleadosAsignados    Empleado[]
  unidadesInmobiliarias UnidadInmobiliaria[]

  @@index([faseActual])
}

model PermisoProyecto {
  id               String             @id @default(uuid()) @db.Uuid
  proyectoId       String             @db.Uuid
  institucion      InstitucionPermiso
  numeroExpediente String?
  estado           EstadoPermiso      @default(PENDIENTE)
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  observaciones    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  // Garantiza un registro único por entidad regulatoria (OPAMSS, MARN, ANDA) por proyecto
  @@unique([proyectoId, institucion])
  @@index([estado])
}

// ============================================================================
// MÓDULO 2: BODEGA E INVENTARIO MULTI-SITIO
// ============================================================================

model Bodega {
  id         String     @id @default(uuid()) @db.Uuid
  codigo     String     @unique
  nombre     String
  tipo       TipoBodega
  ubicacion  String
  proyectoId String?    @unique @db.Uuid // Opcional para CENTRAL, único para PROYECTO
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  proyecto         Proyecto?          @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  inventarios      InventarioBodega[]
  trasladosOrigen  TrasladoBodega[]   @relation("BodegaOrigen")
  trasladosDestino TrasladoBodega[]   @relation("BodegaDestino")

  @@index([tipo])
}

model Material {
  id                    String   @id @default(uuid()) @db.Uuid
  sku                   String   @unique
  nombre                String
  unidadMedida          String   // Ej. "BOLSA", "M3", "VARILLA", "QUINTAL"
  costoUnitarioPromedio Decimal  @db.Decimal(12, 2)
  stockMinimoAlerta     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  inventarios       InventarioBodega[]
  detallesTraslado  DetalleTraslado[]
  recetasPartida    PartidaMaterial[]

  @@index([nombre])
}

model InventarioBodega {
  id                 String   @id @default(uuid()) @db.Uuid
  bodegaId           String   @db.Uuid
  materialId         String   @db.Uuid
  cantidadDisponible Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt          DateTime @updatedAt

  bodega   Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([bodegaId, materialId])
  @@index([materialId])
}

model TrasladoBodega {
  id              String         @id @default(uuid()) @db.Uuid
  codigo          String         @unique
  bodegaOrigenId  String         @db.Uuid
  bodegaDestinoId String         @db.Uuid
  autorizadoPorId String         @db.Uuid
  estado          EstadoTraslado @default(PENDIENTE)
  fechaTraslado   DateTime       @default(now())
  observaciones   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bodegaOrigen  Bodega            @relation("BodegaOrigen", fields: [bodegaOrigenId], references: [id], onDelete: Restrict)
  bodegaDestino Bodega            @relation("BodegaDestino", fields: [bodegaDestinoId], references: [id], onDelete: Restrict)
  autorizadoPor Usuario           @relation("UsuarioAutorizaTraslado", fields: [autorizadoPorId], references: [id], onDelete: Restrict)
  detalles      DetalleTraslado[]

  @@index([bodegaOrigenId])
  @@index([bodegaDestinoId])
  @@index([estado])
}

model DetalleTraslado {
  id                String  @id @default(uuid()) @db.Uuid
  trasladoId        String  @db.Uuid
  materialId        String  @db.Uuid
  cantidad          Decimal @db.Decimal(12, 2)
  costoUnitarioSnap Decimal @default(0) @db.Decimal(12, 2)

  traslado TrasladoBodega @relation(fields: [trasladoId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([trasladoId, materialId])
}

// ============================================================================
// MÓDULO 3: EJECUCIÓN Y PARTIDAS DE OBRA
// ============================================================================

model PartidaObra {
  id                       String       @id @default(uuid()) @db.Uuid
  proyectoId               String       @db.Uuid
  codigo                   String
  nombre                   String       // Ej. "Fundición de Losa Nivel 1"
  faseRequerida            FaseProyecto
  presupuestoAsignado      Decimal      @db.Decimal(14, 2)
  costoMaterialesAcumulado Decimal      @default(0) @db.Decimal(14, 2)
  porcentajeAvance         Decimal      @default(0) @db.Decimal(5, 2) // De 0.00 a 100.00
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  proyecto        Proyecto               @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  recetaMateriales PartidaMaterial[]
  reportesAvance  ReporteAvancePartida[]

  @@unique([proyectoId, codigo])
  @@index([proyectoId, faseRequerida])
}

model PartidaMaterial {
  id                         String  @id @default(uuid()) @db.Uuid
  partidaId                  String  @db.Uuid
  materialId                 String  @db.Uuid
  cantidadTotalRequerida     Decimal @db.Decimal(12, 2)
  cantidadConsumidaAcumulada Decimal @default(0) @db.Decimal(12, 2)

  partida  PartidaObra @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  material Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([partidaId, materialId])
}

model ReporteAvancePartida {
  id                   String   @id @default(uuid()) @db.Uuid
  partidaId            String   @db.Uuid
  ingenieroId          String   @db.Uuid
  porcentajeAnterior   Decimal  @db.Decimal(5, 2)
  porcentajeNuevo      Decimal  @db.Decimal(5, 2)
  deltaPorcentaje      Decimal  @db.Decimal(5, 2)
  costoMaterialesDelta Decimal  @db.Decimal(14, 2)
  observaciones        String?
  fechaReporte         DateTime @default(now())

  partida   PartidaObra @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  ingeniero Usuario     @relation("IngenieroReportaAvance", fields: [ingenieroId], references: [id], onDelete: Restrict)

  @@index([partidaId, fechaReporte])
}

// ============================================================================
// MÓDULO 4: RECURSOS HUMANOS Y NÓMINA DUAL (EL SALVADOR)
// ============================================================================

model Empleado {
  id                    String             @id @default(uuid()) @db.Uuid
  codigo                String             @unique
  nombres               String
  apellidos             String
  dui                   String             @unique // Documento Único de Identidad SV
  nit                   String?            // Homologado con DUI o NIT tributario
  nup                   String?            // Número Único Previsional (AFP Confía / Crecer)
  numeroIsss            String?            // Número de afiliación ISSS
  cargo                 String
  tipoPlanilla          TipoPlanilla
  modalidadPago         ModalidadPagoCampo
  salarioBaseMensual    Decimal?           @db.Decimal(10, 2)
  tarifaDiaria          Decimal?           @db.Decimal(10, 2)
  tarifaUnitariaDestajo Decimal?           @db.Decimal(10, 2)
  proyectoAsignadoId    String?            @db.Uuid
  activo                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  proyectoAsignado Proyecto?    @relation(fields: [proyectoAsignadoId], references: [id], onDelete: SetNull)
  boletasPago      BoletaPago[]

  @@index([tipoPlanilla, activo])
  @@index([proyectoAsignadoId])
}

model Planilla {
  id            String         @id @default(uuid()) @db.Uuid
  codigo        String         @unique
  tipo          TipoPlanilla
  periodoInicio DateTime
  periodoFin    DateTime
  estado        EstadoPlanilla @default(BORRADOR)
  totalBruto    Decimal        @default(0) @db.Decimal(14, 2)
  totalIsss     Decimal        @default(0) @db.Decimal(14, 2)
  totalAfp      Decimal        @default(0) @db.Decimal(14, 2)
  totalRenta    Decimal        @default(0) @db.Decimal(14, 2)
  totalLiquido  Decimal        @default(0) @db.Decimal(14, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  boletas BoletaPago[]

  @@index([tipo, estado])
  @@index([periodoInicio, periodoFin])
}

model BoletaPago {
  id               String   @id @default(uuid()) @db.Uuid
  planillaId       String   @db.Uuid
  empleadoId       String   @db.Uuid
  diasTrabajados   Int?
  unidadesDestajo  Decimal? @db.Decimal(10, 2)
  ingresoBruto     Decimal  @db.Decimal(12, 2)
  descuentoIsss    Decimal  @db.Decimal(12, 2) // 3% con techo de cotización SV ($1,000.00 -> máx $30.00 mensual)
  descuentoAfp     Decimal  @db.Decimal(12, 2) // 7.25% laboral SV
  descuentoRenta   Decimal  @db.Decimal(12, 2) // Retención ISR según tablas de Ministerio de Hacienda SV
  otrasDeducciones Decimal  @default(0) @db.Decimal(12, 2)
  liquidoPagar     Decimal  @db.Decimal(12, 2)
  fechaEmision     DateTime @default(now())

  planilla Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@unique([planillaId, empleadoId])
  @@index([empleadoId])
}

// ============================================================================
// MÓDULO 5: VENTAS E INMOBILIARIA CRM Y FACTURACIÓN FISCAL SV
// ============================================================================

model Cliente {
  id             String      @id @default(uuid()) @db.Uuid
  tipo           TipoCliente
  nombreCompleto String
  dui            String?     @unique
  nit            String?     @unique
  nrc            String?     @unique // Número de Registro de Contribuyente (requerido para CCF)
  giro           String?     // Actividad económica (requerido para CCF)
  direccion      String
  telefono       String
  email          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contratos ContratoVenta[]

  @@index([tipo])
  @@index([nombreCompleto])
}

model UnidadInmobiliaria {
  id                  String                 @id @default(uuid()) @db.Uuid
  proyectoId          String                 @db.Uuid
  codigo              String                 @unique // Ej. "LOTE-A12" o "APTO-302"
  tipo                TipoUnidadInmobiliaria // "CASA", "APARTAMENTO", "LOTE"
  areaMetrosCuadrados Decimal                @db.Decimal(10, 2)
  precioLista         Decimal                @db.Decimal(14, 2)
  estado              EstadoUnidad           @default(DISPONIBLE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  proyecto Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  contrato ContratoVenta?

  @@index([proyectoId, estado])
}

model ContratoVenta {
  id                  String         @id @default(uuid()) @db.Uuid
  codigo              String         @unique
  clienteId           String         @db.Uuid
  unidadId            String         @unique @db.Uuid
  vendedorId          String         @db.Uuid
  precioVentaAcordado Decimal        @db.Decimal(14, 2)
  montoPrima          Decimal        @db.Decimal(14, 2)
  montoFinanciado     Decimal        @db.Decimal(14, 2)
  plazoMeses          Int
  tasaInteresAnual    Decimal        @db.Decimal(5, 2)
  saldoPendiente      Decimal        @db.Decimal(14, 2)
  estado              EstadoContrato @default(ACTIVO)
  fechaFirma          DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  cliente           Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  unidad            UnidadInmobiliaria     @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  vendedor          Usuario                @relation("VendedorContrato", fields: [vendedorId], references: [id], onDelete: Restrict)
  cuotas            CuotaPago[]
  documentosFiscales DocumentoFiscalVenta[]

  @@index([clienteId])
  @@index([estado])
}

model CuotaPago {
  id               String      @id @default(uuid()) @db.Uuid
  contratoId       String      @db.Uuid
  numeroCuota      Int
  fechaVencimiento DateTime
  montoCapital     Decimal     @db.Decimal(12, 2)
  montoInteres     Decimal     @db.Decimal(12, 2)
  montoTotalCuota  Decimal     @db.Decimal(12, 2)
  estado           EstadoCuota @default(PENDIENTE)
  fechaPago        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  contrato          ContratoVenta          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  documentosFiscales DocumentoFiscalVenta[]

  @@unique([contratoId, numeroCuota])
  @@index([contratoId, estado])
  @@index([fechaVencimiento])
}

model DocumentoFiscalVenta {
  id              String              @id @default(uuid()) @db.Uuid
  numeroDocumento String              @unique
  contratoId      String              @db.Uuid
  cuotaId         String?             @db.Uuid
  tipoDocumento   TipoDocumentoFiscal
  montoGravado    Decimal             @db.Decimal(12, 2)
  montoIva        Decimal             @db.Decimal(12, 2) // 13% IVA Ministerio de Hacienda SV
  montoTotal      Decimal             @db.Decimal(12, 2)
  concepto        String
  fechaEmision    DateTime            @default(now())

  contrato ContratoVenta @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  cuota    CuotaPago?    @relation(fields: [cuotaId], references: [id], onDelete: SetNull)

  @@index([contratoId])
  @@index([tipoDocumento, fechaEmision])
}
